# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.
# Real environment variables always win over anything set here.

# --- Core -----------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
# Comma-separated, e.g. https://sfm.example.com — ignored while DEBUG is on.
CORS_ALLOWED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- MySQL ----------------------------------------------------------------
# DB_PASSWORD is mandatory when DJANGO_DEBUG=False — the app refuses to start
# rather than connect as a passwordless user.
DB_NAME=sfm_db
DB_USER=sfm_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Seconds a connection is reused before being reopened (0 = close every time).
# 60 suits a server behind gunicorn, where the worker count bounds the number
# of connections. Set 0 for local work: `runserver` starts a thread per request
# and each holds its own connection for this long, so a parallel test sweep
# exhausts MySQL's max_connections and every request 500s until they expire.
DB_CONN_MAX_AGE=60
# Seconds to wait for the handshake before giving up.
DB_CONNECT_TIMEOUT=10
# 'read committed' (recommended) or 'repeatable read' (MySQL's own default).
DB_ISOLATION_LEVEL=read committed
# Wrap every request in a transaction. Enable once write endpoints exist.
DB_ATOMIC_REQUESTS=False
# TLS for managed MySQL: path to the CA bundle, and one of
# DISABLED / PREFERRED / REQUIRED / VERIFY_CA / VERIFY_IDENTITY.
DB_SSL_CA=
DB_SSL_MODE=

# --- API ------------------------------------------------------------------
API_PAGE_SIZE=20
THROTTLE_ANON=30/min
THROTTLE_USER=2000/hour
# 10/min on login is what makes password guessing impractical. Local
# development raises these so a test run does not throttle itself, and those
# raised values must never reach production — two tests in accounts.tests fail
# on purpose when they have.
THROTTLE_LOGIN=10/min
THROTTLE_OTP=5/min
THROTTLE_INVITE=5/hour

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Uploads --------------------------------------------------------------
DJANGO_MEDIA_ROOT=
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# --- Business rules -------------------------------------------------------
# All optional; the defaults shown are what the code uses if unset. Listed so
# an operator knows they are tunable without reading settings.py.

# Local numbering. +91 / 10 digits suits India.
# DEFAULT_COUNTRY_CODE=+91
# NATIONAL_NUMBER_LENGTH=10

# Stock at or below this is reported as low.
# PRODUCTS_LOW_STOCK_THRESHOLD=25

# Punches after this hour are marked late (24-hour clock, server time zone).
# ATTENDANCE_LATE_HOUR=10

# A punch without a selfie is refused. Turning this off weakens the only
# evidence that the person was where the punch says.
# ATTENDANCE_SELFIE_REQUIRED=True

# Refuse a punch taken outside the assigned geofence. Off by default because a
# site's pin is often approximate while somebody is standing on it.
# ATTENDANCE_ENFORCE_GEOFENCE=False

# Reject a GPS fix vaguer than this, in metres.
# ATTENDANCE_MAX_ACCURACY_METERS=100

# How far back a queued punch may be replayed, and how much the device clock
# may run ahead before its timestamp is refused.
# ATTENDANCE_MAX_BACKDATE_DAYS=7
# ATTENDANCE_CLOCK_SKEW_MINUTES=5

# --- Production only ------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=2592000
