# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.
# Real environment variables always win over anything set here.

# --- Core -----------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
# Comma-separated, e.g. https://sfm.example.com — ignored while DEBUG is on.
CORS_ALLOWED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- MySQL ----------------------------------------------------------------
# DB_PASSWORD is mandatory when DJANGO_DEBUG=False — the app refuses to start
# rather than connect as a passwordless user.
DB_NAME=sfm_db
DB_USER=sfm_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Seconds a connection is reused before being reopened (0 = close every time).
DB_CONN_MAX_AGE=60
# Seconds to wait for the handshake before giving up.
DB_CONNECT_TIMEOUT=10
# 'read committed' (recommended) or 'repeatable read' (MySQL's own default).
DB_ISOLATION_LEVEL=read committed
# Wrap every request in a transaction. Enable once write endpoints exist.
DB_ATOMIC_REQUESTS=False
# TLS for managed MySQL: path to the CA bundle, and one of
# DISABLED / PREFERRED / REQUIRED / VERIFY_CA / VERIFY_IDENTITY.
DB_SSL_CA=
DB_SSL_MODE=

# --- API ------------------------------------------------------------------
API_PAGE_SIZE=20
THROTTLE_ANON=30/min
THROTTLE_USER=2000/hour
THROTTLE_LOGIN=10/min
THROTTLE_OTP=5/min

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Uploads --------------------------------------------------------------
DJANGO_MEDIA_ROOT=
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# --- Production only ------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=2592000
